BOT_TOKEN=

DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Alchemy enables startup and daily backups, and injects R2 credentials on Railway.
DATABASE_BACKUP_ENABLED=false
# UTC cron expression, read only when backups are enabled.
DATABASE_BACKUP_CRON=0 3 * * *
R2_BACKUP_BUCKET=
R2_BACKUP_ENDPOINT=
R2_BACKUP_ACCESS_KEY_ID=
R2_BACKUP_SECRET_ACCESS_KEY=

RUN_MODE=polling

PORT=3000
WEBHOOK_URL=

REDIS_URL=

# Forward non-command messages from these users to the owner's Telegram chat.
# Usernames may include @ and are matched case-insensitively.
TELEGRAM_FORWARD_USERNAMES=user_one,@user_two
OWNER_TELEGRAM_ID=
